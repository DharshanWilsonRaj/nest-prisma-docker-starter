# App
NODE_ENV=development
CLIENT_CONTAINER_NAME=frontend_client
SERVER_CONTAINER_NAME=backend_server

# Client
CLIENT_PORT=5174
VITE_API_URL=http://backend_server:3000

# Server
SERVER_PORT=3000

# PostgreSQL
POSTGRES_CONTAINER_NAME=postgres_db
POSTGRES_HOST=postgres
POSTGRES_PORT=15432
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=appdb

# Prisma
DATABASE_URL=postgresql://appuser:apppassword@postgres:15432/appdb?schema=public
PRISMA_STUDIO_CONTAINER_NAME=prisma_studio
PRISMA_STUDIO_PORT=5556

# pgAdmin
PGADMIN_CONTAINER_NAME=pgadmin_ui
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Docker Network
DOCKER_NETWORK_NAME=fullstack_network
